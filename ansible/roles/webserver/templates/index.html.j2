<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site_title }} — {{ ansible_hostname }}</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0;
           display: flex; min-height: 100vh; align-items: center; justify-content: center;
           margin: 0; }
    .card { background: #1e293b; padding: 2.5rem 3rem; border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,.4); max-width: 34rem; }
    h1 { margin-top: 0; font-size: 1.5rem; }
    dt { color: #94a3b8; font-size: .8rem; text-transform: uppercase;
         letter-spacing: .05em; margin-top: 1rem; }
    dd { margin: .2rem 0 0; font-family: ui-monospace, monospace; font-size: 1.05rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>{{ site_title }}</h1>
    <p>Provisioned with Terraform, configured with Ansible.</p>
    <dl>
      <dt>Hostname</dt><dd>{{ ansible_hostname }}</dd>
      <dt>Inventory name</dt><dd>{{ inventory_hostname }}</dd>
      <dt>Private IP</dt><dd>{{ ansible_default_ipv4.address }}</dd>
      <dt>Operating system</dt><dd>{{ ansible_distribution }} {{ ansible_distribution_version }}</dd>
      <dt>Deployed at (UTC)</dt><dd>{{ deployed_at }}</dd>
      <dt>Environment</dt><dd>{{ site_environment }}</dd>
      <dt>Owner</dt><dd>{{ site_owner }}</dd>
    </dl>
  </div>
</body>
</html>
