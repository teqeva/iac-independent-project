# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

aws_region      = "eu-west-1"
project_name    = "iac-project"
owner           = "your-name"
admin_ip_cidr   = "203.0.113.25/32" # your public IP: curl -s https://checkip.amazonaws.com
public_key_path = "~/.ssh/iac-project.pub"
instance_type   = "t3.micro"
instance_count  = 2
